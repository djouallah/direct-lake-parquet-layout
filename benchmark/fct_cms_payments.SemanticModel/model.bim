            "name": "Program_Year",
            "dataType": "int64",
            "sourceColumn": "Program_Year",
            "sourceLineageTag": "Program_Year",
            "summarizeBy": "none",
            "description": "Reporting year the record was published under. NOT always equal to YEAR(Date_of_Payment) — CMS accepts payments dated outside their program year, which is why the downloader buckets months by the actual payment date."
          },
          {
            "name": "Payment_Publication_Date",
            "dataType": "dateTime",
            "sourceColumn": "Payment_Publication_Date",
            "sourceLineageTag": "Payment_Publication_Date",
            "summarizeBy": "none",
            "description": "Payment Publication Date",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "file",
            "dataType": "string",
            "sourceColumn": "file",
            "sourceLineageTag": "file",
            "summarizeBy": "none",
            "description": "Source month, e.g. cms_2023-06 — leads the incremental key"
          }
        ],
        "measures": [
          {
            "name": "Total Amount",
            "description": "Dollars paid across the selection",
            "expression": "SUM(fct_cms_payments[Total_Amount_of_Payment_USDollars])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Total Payments",
            "description": "Row count of the fact",
            "expression": "COUNTROWS(fct_cms_payments)",
            "formatString": "#,##0"
          },
          {
            "name": "Avg Payment",
            "description": "Mean payment amount",
            "expression": "AVERAGE(fct_cms_payments[Total_Amount_of_Payment_USDollars])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Payment Count",
            "description": "Individual payments, where a row may roll several together",
            "expression": "SUM(fct_cms_payments[Number_of_Payments_Included_in_Total_Amount])",
            "formatString": "#,##0"
          },
          {
            "name": "Distinct Recipients",
            "description": "Payees receiving anything in the selection — a DISTINCTCOUNT over a near-unique column, deliberately the most expensive measure here",
            "expression": "DISTINCTCOUNT(fct_cms_payments[Covered_Recipient_Profile_ID])",
            "formatString": "#,##0"
          },
          {
            "name": "Distinct Products",
            "description": "Named products in the selection, first product slot only",
            "expression": "DISTINCTCOUNT(fct_cms_payments[Name_of_Drug_or_Biological_or_Device_or_Medical_Supply_1])",
            "formatString": "#,##0"
          }
        ],
        "partitions": [
          {
            "name": "fct_cms_payments",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fct_cms_payments",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "dim_cms_payer",
        "description": "The manufacturers and GPOs that make the payments (~1,000 live ids).\nDerived at land time from the archive itself — CMS publishes no manufacturer lookup — one row per id, newest program year winning.\npayer_id is a STRING key, which is why this dataset carries a whitespace assertion in all three dialects.",
        "sourceLineageTag": "[mart].[dim_cms_payer]",
        "columns": [
          {
            "name": "payer_id",
            "dataType": "string",
            "sourceColumn": "payer_id",
            "sourceLineageTag": "payer_id",
            "summarizeBy": "none",
            "description": "Manufacturer/GPO id (primary key)",
            "isKey": true
          },
          {
            "name": "payer_name",
            "dataType": "string",
            "sourceColumn": "payer_name",
            "sourceLineageTag": "payer_name",
            "summarizeBy": "none",
            "description": "Company name as of the newest program year that named this id"
          },
          {
            "name": "payer_state",
            "dataType": "string",
            "sourceColumn": "payer_state",
            "sourceLineageTag": "payer_state",
            "summarizeBy": "none",
            "description": "Two-letter state of the paying entity"
          },
          {
            "name": "payer_country",
            "dataType": "string",
            "sourceColumn": "payer_country",
            "sourceLineageTag": "payer_country",
            "summarizeBy": "none",
            "description": "Country of the paying entity — ~99.7% 'United States'"
          }
        ],
        "partitions": [
          {
            "name": "dim_cms_payer",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "dim_cms_payer",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "dim_cms_date",
        "description": "Date dimension covering 2013-01-01 to 2027-12-31.\nWider than the archive on purpose: CMS payments carry dates outside their own program year, and the fact's date relationship asserts referential integrity, so a narrowed span would inner-join those rows away.",
        "sourceLineageTag": "[mart].[dim_cms_date]",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "description": "Calendar date (primary key). One row per day.",
            "isKey": true,
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "year",
            "dataType": "int64",
            "sourceColumn": "year",
            "sourceLineageTag": "year",
            "summarizeBy": "none",
            "description": "Calendar year (e.g. 2019)"
          },
          {
            "name": "month",
            "dataType": "int64",
            "sourceColumn": "month",
            "sourceLineageTag": "month",
            "summarizeBy": "none",
            "description": "Calendar month number (1-12)"
          },
          {
            "name": "day_of_week",
            "dataType": "int64",
            "sourceColumn": "day_of_week",
            "sourceLineageTag": "day_of_week",
            "summarizeBy": "none",
            "description": "0=Sunday. Normalised identically in all three dialects, so a difference here would be real rather than a dialect artefact."
          }
        ],
        "partitions": [
          {
            "name": "dim_cms_date",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "dim_cms_date",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "stg_cms_archive_log",
        "description": "The archive log download_cms_payments.py writes.\nOne row per landed MONTH, with source_filename naming the annual CSV it was split out of — this is the one dataset where the watermark unit and the landed unit differ.",
        "sourceLineageTag": "[landing].[stg_cms_archive_log]",
        "columns": [
          {
            "name": "source_type",
            "dataType": "string",
            "sourceColumn": "source_type",
            "sourceLineageTag": "source_type",
            "summarizeBy": "none",
            "description": "'cms' for a landed month, 'payer' for the derived lookup"
          },
          {
            "name": "source_filename",
            "dataType": "string",
            "sourceColumn": "source_filename",
            "sourceLineageTag": "source_filename",
            "summarizeBy": "none",
            "description": "The annual CSV this month came out of — the watermark, repeated across the ~12 rows of one program year"
          },
          {
            "name": "archive_path",
            "dataType": "string",
            "sourceColumn": "archive_path",
            "sourceLineageTag": "archive_path",
            "summarizeBy": "none",
            "description": "Path under parquet_raw/"
          },
          {
            "name": "file_stem",
            "dataType": "string",
            "sourceColumn": "file_stem",
            "sourceLineageTag": "file_stem",
            "summarizeBy": "none",
            "description": "Filename without extension — what fct_cms_payments stores as `file`"
          },
          {
            "name": "row_count",
            "dataType": "int64",
            "sourceColumn": "row_count",
            "sourceLineageTag": "row_count",
            "summarizeBy": "sum",
            "description": "Rows in this landed month",
            "formatString": "#,##0"
          },
          {
            "name": "columns",
            "dataType": "string",
            "sourceColumn": "columns",
            "sourceLineageTag": "columns",
            "summarizeBy": "none",
            "description": "The source CSV's own header, as CMS published it — all 91"
          },
          {
            "name": "archived_at",
            "dataType": "dateTime",
            "sourceColumn": "archived_at",
            "sourceLineageTag": "archived_at",
            "summarizeBy": "none",
            "description": "When the file was archived",
            "formatString": "yyyy-MM-dd HH:mm"
          }
        ],
        "measures": [
          {
            "name": "Archive Files",
            "description": "Months landed",
            "expression": "COUNTROWS(stg_cms_archive_log)",
            "formatString": "#,##0"
          },
          {
            "name": "Archive Source Rows",
            "description": "Rows across every landed month",
            "expression": "SUM(stg_cms_archive_log[row_count])",
            "formatString": "#,##0"
          }
        ],
        "partitions": [
          {
            "name": "stg_cms_archive_log",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "stg_cms_archive_log",
              "expressionSource": "DirectLake",
              "schemaName": "landing"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "fct_cms_payments_to_dim_cms_payer",
        "fromTable": "fct_cms_payments",
        "fromColumn": "Applicable_Manufacturer_or_Applicable_GPO_Making_Payment_ID",
        "toTable": "dim_cms_payer",
        "toColumn": "payer_id",
        "relyOnReferentialIntegrity": true
      },
      {
        "name": "fct_cms_payments_to_dim_cms_date",
        "fromTable": "fct_cms_payments",
        "fromColumn": "Date_of_Payment",
        "toTable": "dim_cms_date",
        "toColumn": "date",
        "relyOnReferentialIntegrity": true
      }
    ]
  }
