{
  "compatibilityLevel": 1604,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "annotations": [
      {
        "name": "PBI_ProTooling",
        "value": "[\"RemoteModeling\", \"DirectLakeOnOneLakeCreatedInDesktop\"]"
      }
    ],
    "expressions": [
      {
        "name": "DirectLake",
        "kind": "m",
        "description": "Direct Lake connection to OneLake — reads the Delta tables directly, no SQL endpoint. The two GUIDs are workspace + item and are REWRITTEN at deploy time by duckrun's workspace.deploy(lakehouse=...) — which is how this ONE template serves all four engines, warehouse included, since deploy(mode=) made the storage mode independent of the item kind (duckrun 0.4.36). The checked-in pair is a PLACEHOLDER of zeros, not a real workspace and item: it is overwritten before this template is ever deployed, and the real ids live in repo secrets. What must NOT change is the shape - _is_directlake_bim() greps the raw bytes for a onelake.dfs URL to decide this is a Direct Lake model, so removing the URL, or the camelCase mode token, silently turns it into something deploy cannot serve.",
        "expression": [
          "let",
          "    Source = AzureStorage.DataLake(\"https://onelake.dfs.fabric.microsoft.com/00000000-0000-0000-0000-000000000000/00000000-0000-0000-0000-000000000000\", [HierarchicalNavigation=true])",
          "in",
          "    Source"
        ]
      }
    ],
    "tables": [
      {
        "name": "fct_cms_payments",
        "description": "CMS Open Payments general-payment records — the wide raw fact, and the table under layout test.\nGrain: one row per payment record, uniquely identified by Record_ID.\n91 source columns, of which 54 are >50% NULL: this is the WIDE and SPARSE point on the surface, and the only table here carrying both skew regimes at once.",
        "sourceLineageTag": "[mart].[fct_cms_payments]",
        "columns": [
          {
            "name": "Change_Type",
            "dataType": "string",
            "sourceColumn": "Change_Type",
            "sourceLineageTag": "Change_Type",
            "summarizeBy": "none",
            "description": "Change Type"
          },
          {
            "name": "Covered_Recipient_Type",
            "dataType": "string",
            "sourceColumn": "Covered_Recipient_Type",
            "sourceLineageTag": "Covered_Recipient_Type",
            "summarizeBy": "none",
            "description": "Physician, non-physician practitioner, or teaching hospital. ~65% one value."
          },
          {
            "name": "Teaching_Hospital_CCN",
            "dataType": "string",
            "sourceColumn": "Teaching_Hospital_CCN",
            "sourceLineageTag": "Teaching_Hospital_CCN",
            "summarizeBy": "none",
            "description": "Set only when the payee is a teaching hospital — 99.8% NULL. Sparse for a structural reason (a payment goes to a person or a hospital, never both) rather than because the field is optional."
          },
          {
            "name": "Teaching_Hospital_ID",
            "dataType": "int64",
            "sourceColumn": "Teaching_Hospital_ID",
            "sourceLineageTag": "Teaching_Hospital_ID",
            "summarizeBy": "none",
            "description": "Teaching Hospital ID",
            "formatString": "#,##0"
          },
          {
            "name": "Teaching_Hospital_Name",
            "dataType": "string",
            "sourceColumn": "Teaching_Hospital_Name",
            "sourceLineageTag": "Teaching_Hospital_Name",
            "summarizeBy": "none",
            "description": "Teaching Hospital Name"
          },
          {
            "name": "Covered_Recipient_Profile_ID",
            "dataType": "int64",
            "sourceColumn": "Covered_Recipient_Profile_ID",
            "sourceLineageTag": "Covered_Recipient_Profile_ID",
            "summarizeBy": "none",
            "description": "CMS's id for the payee. Near-unique — ~128K distinct in a 187K-row sample.",
            "formatString": "#,##0"
          },
          {
            "name": "Covered_Recipient_NPI",
            "dataType": "int64",
            "sourceColumn": "Covered_Recipient_NPI",
            "sourceLineageTag": "Covered_Recipient_NPI",
            "summarizeBy": "none",
            "description": "National Provider Identifier of the payee. Ten digits, hence int64.",
